{
    "name": "ceydrew/laravel-tr-validation",
    "description": "Laravel validation rules for Turkish data: TC Kimlik No (TCKN), Vergi Kimlik No (VKN), TR IBAN, Turkish phone numbers and vehicle plates.",
    "keywords": ["laravel", "validation", "turkey", "turkish", "tckn", "tc-kimlik", "vkn", "vergi-no", "iban", "phone", "plaka"],
    "homepage": "https://github.com/CeyDrew/laravel-tr-validation",
    "license": "MIT",
    "authors": [
        {
            "name": "Abdurrahman Bilici",
            "homepage": "https://github.com/CeyDrew"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "CeyDrew\\TrValidation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CeyDrew\\TrValidation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CeyDrew\\TrValidation\\TrValidationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
